# ひとり経理 環境変数テンプレート
# このファイルをコピーして .env.local を作り、実値を入れる(.env.local は git 管理外)。
#
# 重要: クライアントに公開してよい値だけを EXPO_PUBLIC_ で持つ。
# 秘密鍵(OCRのAPIキー等)はここに置かず、Supabase Edge Function の
# サーバ環境変数で管理する(docs/development/tech-stack.md)。

# --- Supabase(クライアント公開可。RLS 前提) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- OCR(任意) ---
# 1 にすると OCR を常にモックにする(API コストをかけず UI を確認する開発用)
# EXPO_PUBLIC_OCR_MOCK=1

# --- サーバ専用(クライアントには置かない。Supabase の関数シークレットで設定) ---
# OCRプロバイダーは切替式。secrets で選ぶ(既定: anthropic)。
#
# OpenAI を使う場合(既定モデル gpt-4o-mini):
#   supabase secrets set OCR_PROVIDER=openai OPENAI_API_KEY=sk-...
#   supabase functions deploy ocr-receipt
#
# Claude を使う場合(既定モデル claude-haiku-4-5):
#   supabase secrets set OCR_PROVIDER=anthropic ANTHROPIC_API_KEY=sk-ant-...
#   supabase functions deploy ocr-receipt
#
# モデルを変えたい場合(任意。アクティブなプロバイダーに適用):
#   supabase secrets set OCR_MODEL=gpt-4o        # OpenAI 精度優先
#   supabase secrets set OCR_MODEL=claude-sonnet-4-6   # Claude 精度優先
